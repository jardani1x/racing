# Text normalization
* text=auto

# Explicitly text
*.md        text
*.cs        text
*.cpp       text
*.h         text
*.ini       text
*.json      text
*.ts        text
*.js        text
*.py        text
*.uproject  text
*.uplugin   text

# ---------------------------------------------------------------------------
# Unreal binary assets.
#
# `lockable` implements hard constraint #7 (no parallel .uasset/.umap edits) and
# CLAUDE.md's "do not attempt text merges of Unreal binary assets".
#
# LIMITATION: git-lfs lock enforcement requires an LFS server. This repository
# is local-only (see Docs/ADR/ADR-0004), so locks are ADVISORY until a remote
# exists. Content changes must still be serialized in the integration checkout
# by process, not by tooling.
# ---------------------------------------------------------------------------
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable

# Source art and media
*.fbx     filter=lfs diff=lfs merge=lfs -text lockable
*.blend   filter=lfs diff=lfs merge=lfs -text lockable
*.psd     filter=lfs diff=lfs merge=lfs -text lockable
*.tga     filter=lfs diff=lfs merge=lfs -text lockable
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text lockable
*.ogg     filter=lfs diff=lfs merge=lfs -text lockable
*.mp4     filter=lfs diff=lfs merge=lfs -text

# Archives and binaries
*.zip     filter=lfs diff=lfs merge=lfs -text
*.7z      filter=lfs diff=lfs merge=lfs -text
*.dll     filter=lfs diff=lfs merge=lfs -text
*.so      filter=lfs diff=lfs merge=lfs -text
